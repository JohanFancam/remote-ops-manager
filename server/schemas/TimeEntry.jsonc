{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "operator_email": {
      "type": "string"
    },
    "operator_name": {
      "type": "string"
    },
    "shoot_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "hours": {
      "type": "number"
    },
    "rate": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid"
      ],
      "default": "pending"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "clock",
        "coffee_break",
        "lunch_break",
        "manual"
      ],
      "default": "manual"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "operator_email",
    "date",
    "hours"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.operator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.operator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accounts"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.operator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.operator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}