{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "standby",
        "accounts",
        "analytics",
        "viewer"
      ],
      "default": "user"
    },
    "timezone": {
      "type": "string",
      "default": "Africa/Johannesburg",
      "description": "IANA time zone for displaying clocks and shoot times. Default is South African Time. Use device to follow the phone or computer."
    }
  }
}