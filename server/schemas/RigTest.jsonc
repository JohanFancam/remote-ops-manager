{
  "name": "RigTest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short description e.g. 'Weekly Rig Test'"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Date the rig test is scheduled for"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Optional due date by which the rig test must be completed"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the admin/standby assigned to this test"
    },
    "assigned_name": {
      "type": "string",
      "description": "Display name of the assigned person"
    },
    "rig_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional list of rig IDs being tested"
    },
    "checklist": {
      "type": "array",
      "description": "Checklist items with completion status",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          }
        }
      }
    },
    "comments": {
      "type": "string",
      "description": "General comments / issues found during testing"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending"
    },
    "completed_at": {
      "type": "string",
      "description": "ISO timestamp when marked complete"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "scheduled_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "standby"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}