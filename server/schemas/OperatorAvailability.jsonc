{
  "name": "OperatorAvailability",
  "type": "object",
  "properties": {
    "operator_email": {
      "type": "string",
      "description": "Email of the remote operator"
    },
    "operator_name": {
      "type": "string",
      "description": "Display name of the operator"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "First date of unavailability"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Last date of unavailability"
    },
    "type": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ],
      "default": "unavailable",
      "description": "Whether this is an availability or unavailability entry"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes e.g. reason for absence"
    }
  },
  "required": [
    "operator_email",
    "start_date",
    "end_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.operator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.operator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.operator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.operator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}