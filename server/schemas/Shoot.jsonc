{
  "name": "Shoot",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "game_time": {
      "type": "string"
    },
    "setup_offset": {
      "type": "number",
      "default": -150
    },
    "pre_shoot_offset": {
      "type": "number",
      "default": -120
    },
    "attention_offset": {
      "type": "number",
      "default": -30
    },
    "sound_offset": {
      "type": "number",
      "default": -30
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "cancelled",
        "postponed",
        "completed"
      ],
      "default": "upcoming"
    },
    "rig_type_override": {
      "type": "string",
      "enum": [
        "Data",
        "Fancam",
        "Data/Fancam"
      ],
      "description": "Per-shoot rig type override (overrides rig setting default)"
    },
    "description": {
      "type": "string"
    },
    "assigned_operators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_operators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pre_approved_operators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of operators whose assignment counts toward the 6-slot pre-approval limit"
    },
    "auto_assigned_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of operators auto-paired to this shoot"
    },
    "rig_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rate": {
      "type": "number"
    },
    "rate_type": {
      "type": "string",
      "enum": [
        "hourly",
        "day_rate",
        "fixed"
      ],
      "default": "day_rate"
    },
    "notes": {
      "type": "string"
    },
    "standby_admin": {
      "type": "string",
      "description": "Email of admin assigned as standby contact"
    },
    "phase_status": {
      "type": "object",
      "description": "Shoot phase completion timestamps",
      "properties": {
        "setup_complete": {
          "type": "string"
        },
        "pre_shoot_started": {
          "type": "string"
        },
        "attention_started": {
          "type": "string"
        },
        "sound_started": {
          "type": "string"
        },
        "game_started": {
          "type": "string"
        },
        "shoot_complete": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}