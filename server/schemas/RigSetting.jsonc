{
  "name": "RigSetting",
  "type": "object",
  "properties": {
    "team": {
      "type": "string",
      "description": "Team name \u2014 matches shoot client/title"
    },
    "venue_type": {
      "type": "string",
      "enum": [
        "Indoor",
        "Outdoor",
        "Arena"
      ],
      "default": "Indoor"
    },
    "sport": {
      "type": "string",
      "description": "Sport category e.g. NBA, NHL, NFL, Soccer"
    },
    "rig_type": {
      "type": "string",
      "enum": [
        "Data",
        "Fancam",
        "Data/Fancam"
      ],
      "default": "Data",
      "description": "Primary rig output type"
    },
    "shoot_plan": {
      "type": "string",
      "description": "Shoot plan notes"
    },
    "remote_rigs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Label shown on dashboard remote buttons"
          },
          "url": {
            "type": "string",
            "description": "Chrome Remote Desktop link for that PC"
          }
        }
      },
      "description": "Chrome Remote Desktop machines. Paste each PC’s link once; dashboard remotes open that desktop."
    },
    "data_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Data Settings section enabled"
    },
    "data_hd": {
      "type": "object",
      "description": "Data HD Camera: shutter, aperture, iso"
    },
    "data_wide_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Data Wide Camera enabled"
    },
    "data_wide": {
      "type": "object",
      "description": "Data Wide Camera: shutter, aperture, iso"
    },
    "fancam_day_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Fancam Day Settings section enabled"
    },
    "fancam_day_hd": {
      "type": "object",
      "description": "Fancam Day HD Camera: shutter, aperture, iso"
    },
    "fancam_day_wide_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Fancam Day Wide Camera enabled"
    },
    "fancam_day_wide": {
      "type": "object",
      "description": "Fancam Day Wide Camera: shutter, aperture, iso"
    },
    "fancam_night_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Fancam Night Settings section enabled"
    },
    "fancam_night_hd": {
      "type": "object",
      "description": "Fancam Night HD Camera: shutter, aperture, iso"
    },
    "fancam_night_wide_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Fancam Night Wide Camera enabled"
    },
    "fancam_night_wide": {
      "type": "object",
      "description": "Fancam Night Wide Camera: shutter, aperture, iso"
    },
    "attention_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Attention Camera section enabled"
    },
    "attention_hd": {
      "type": "object",
      "description": "Attention Camera HD: shutter, aperture, iso"
    },
    "sound_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Sound Recording enabled"
    },
    "setup_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Show setup time on shoot schedules"
    },
    "pre_shoot_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Show pre-shoot time on shoot schedules"
    },
    "default_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Default rig-check items copied onto assigned testers and assigned shoots"
    },
    "live_data": {
      "type": "boolean",
      "default": false,
      "description": "This team is Live Data — times get first priority when issues need repair"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "team"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}