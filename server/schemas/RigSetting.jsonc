{
  "name": "RigSetting",
  "type": "object",
  "properties": {
    "team": {
      "type": "string",
      "description": "Team name \u2014 matches shoot client/title"
    },
    "venue_type": {
      "type": "string",
      "enum": [
        "Indoor",
        "Outdoor",
        "Arena"
      ],
      "default": "Indoor"
    },
    "sport": {
      "type": "string",
      "description": "Sport category e.g. NBA, NHL, NFL, Soccer"
    },
    "rig_type": {
      "type": "string",
      "enum": [
        "Data",
        "Fancam",
        "Data/Fancam"
      ],
      "default": "Data",
      "description": "Primary rig output type"
    },
    "shoot_plan": {
      "type": "string",
      "description": "Shoot plan notes"
    },
    "remote_rigs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Remote names"
    },
    "data_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Data Settings section enabled"
    },
    "data_hd": {
      "type": "object",
      "description": "Data HD Camera: shutter, aperture, iso"
    },
    "data_wide_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Data Wide Camera enabled"
    },
    "data_wide": {
      "type": "object",
      "description": "Data Wide Camera: shutter, aperture, iso"
    },
    "fancam_day_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Fancam Day Settings section enabled"
    },
    "fancam_day_hd": {
      "type": "object",
      "description": "Fancam Day HD Camera: shutter, aperture, iso"
    },
    "fancam_day_wide_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Fancam Day Wide Camera enabled"
    },
    "fancam_day_wide": {
      "type": "object",
      "description": "Fancam Day Wide Camera: shutter, aperture, iso"
    },
    "fancam_night_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Fancam Night Settings section enabled"
    },
    "fancam_night_hd": {
      "type": "object",
      "description": "Fancam Night HD Camera: shutter, aperture, iso"
    },
    "fancam_night_wide_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Fancam Night Wide Camera enabled"
    },
    "fancam_night_wide": {
      "type": "object",
      "description": "Fancam Night Wide Camera: shutter, aperture, iso"
    },
    "attention_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Attention Camera section enabled"
    },
    "attention_hd": {
      "type": "object",
      "description": "Attention Camera HD: shutter, aperture, iso"
    },
    "sound_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Sound Recording enabled"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "team"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}