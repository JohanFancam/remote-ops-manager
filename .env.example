PORT=3001
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin User
# Production / Railway volume paths:
# DATABASE_PATH=/data/remote-ops.db
# UPLOADS_DIR=/data/uploads

# Google Calendar sync (admin Settings → Connect Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console:
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback
# Where OAuth should send the browser after connect (Vite in dev):
FRONTEND_URL=http://localhost:5173
