{
  "name": "RigSetting",
  "type": "object",
  "properties": {
    "team": {
      "type": "string",
      "description": "Team name \u2014 matches shoot client/title"
    },
    "venue_type": {
      "type": "string",
      "enum": [
        "Indoor",
        "Outdoor"
      ],
      "default": "Indoor"
    },
    "sport": {
      "type": "string",
      "description": "Sport category e.g. NBA, NHL, NFL, Soccer"
    },
    "rig_type": {
      "type": "string",
      "enum": [
        "Data",
        "Fancam",
        "Data/Fancam"
      ],
      "default": "Data",
      "description": "Primary rig output type"
    },
    "shoot_plan": {
      "type": "string",
      "description": "Shoot plan notes"
    },
    "remote_rigs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Remote names"
    },
    "hd_enabled": {
      "type": "boolean",
      "default": true
    },
    "hd": {
      "type": "object",
      "description": "HD Camera settings: shutter, aperture, iso"
    },
    "wide_enabled": {
      "type": "boolean",
      "default": true
    },
    "wide": {
      "type": "object",
      "description": "Wide Camera settings: shutter, aperture, iso"
    },
    "attention_enabled": {
      "type": "boolean",
      "default": false
    },
    "attention": {
      "type": "object",
      "description": "Attention Camera settings: shutter, aperture, iso"
    },
    "sound": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "team"
  ]
}