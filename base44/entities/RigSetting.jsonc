{
  "name": "RigSetting",
  "type": "object",
  "properties": {
    "team": {
      "type": "string",
      "description": "Team name \u2014 matches shoot client/title"
    },
    "location": {
      "type": "string",
      "description": "Default venue / stadium for this team \u2014 auto-pulls through to matched shoots"
    },
    "venue_type": {
      "type": "string",
      "enum": [
        "Indoor",
        "Outdoor",
        "Arena"
      ],
      "default": "Indoor"
    },
    "sport": {
      "type": "string",
      "description": "Sport category e.g. NBA, NHL, NFL, Soccer"
    },
    "rig_type": {
      "type": "string",
      "enum": [
        "Data",
        "Fancam",
        "Data/Fancam"
      ],
      "default": "Data",
      "description": "Primary rig output type"
    },
    "live_data": {
      "type": "boolean",
      "default": false,
      "description": "Live Data shoot \u2014 gets priority and must be attended to immediately if there is an issue"
    },
    "shoot_plan": {
      "type": "string",
      "description": "Shoot plan notes"
    },
    "remote_rigs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Remote names"
    },
    "setup_offset": {
      "type": "number",
      "default": -150,
      "description": "Minutes before game time that setup begins (default per rig setting)"
    },
    "pre_shoot_offset": {
      "type": "number",
      "default": -120,
      "description": "Minutes before game time that pre-shoot begins (default per rig setting)"
    },
    "attention_offset": {
      "type": "number",
      "default": -30,
      "description": "Minutes before game time that attention begins (default per rig setting)"
    },
    "sound_offset": {
      "type": "number",
      "default": -30,
      "description": "Minutes before game time that sound check begins (default per rig setting)"
    },
    "data_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Data Settings section enabled"
    },
    "data_hd": {
      "type": "object",
      "description": "Data HD Camera: shutter, aperture, iso"
    },
    "data_wide_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Data Wide Camera enabled"
    },
    "data_wide": {
      "type": "object",
      "description": "Data Wide Camera: shutter, aperture, iso"
    },
    "fancam_day_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Outdoor Day Settings section enabled"
    },
    "fancam_day_hd": {
      "type": "object",
      "description": "Outdoor Day HD Camera: shutter, aperture, iso"
    },
    "fancam_day_wide_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Outdoor Day Wide Camera enabled"
    },
    "fancam_day_wide": {
      "type": "object",
      "description": "Outdoor Day Wide Camera: shutter, aperture, iso"
    },
    "fancam_night_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Outdoor Night Settings section enabled"
    },
    "fancam_night_hd": {
      "type": "object",
      "description": "Outdoor Night HD Camera: shutter, aperture, iso"
    },
    "fancam_night_wide_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Outdoor Night Wide Camera enabled"
    },
    "fancam_night_wide": {
      "type": "object",
      "description": "Outdoor Night Wide Camera: shutter, aperture, iso"
    },
    "indoor_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Indoor Settings section enabled"
    },
    "indoor_hd": {
      "type": "object",
      "description": "Indoor HD Camera: shutter, aperture, iso"
    },
    "indoor_wide_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Indoor Wide Camera enabled"
    },
    "indoor_wide": {
      "type": "object",
      "description": "Indoor Wide Camera: shutter, aperture, iso"
    },
    "attention_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Attention Camera section enabled"
    },
    "attention_hd": {
      "type": "object",
      "description": "Attention Camera HD: shutter, aperture, iso"
    },
    "sound_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Sound Recording enabled"
    },
    "sound_trigger_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Sound Trigger enabled \u2014 starts sound recording after the game begins"
    },
    "sound_trigger_offset": {
      "type": "number",
      "default": 10,
      "description": "Minutes after game start that the sound trigger fires (default 10)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "team"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}