{
  "name": "StandbyDay",
  "type": "object",
  "properties": {
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date of the standby period"
    },
    "start_time": {
      "type": "string",
      "description": "Time standby begins on start_date e.g. 08:00"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date of the standby period"
    },
    "end_time": {
      "type": "string",
      "description": "Time standby ends on end_date e.g. 08:00"
    },
    "admin_email": {
      "type": "string",
      "description": "Email of admin on standby"
    },
    "admin_name": {
      "type": "string",
      "description": "Display name of admin on standby"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes for this standby period"
    },
    "swapped_from": {
      "type": "string",
      "description": "Original admin email if this was swapped"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Legacy single-day date field (kept for backwards compat)"
    }
  },
  "required": [
    "start_date",
    "admin_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "standby"
          }
        },
        {
          "user_condition": {
            "role": "operator_standby"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "operator_standby"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "operator_standby"
          }
        }
      ]
    }
  }
}