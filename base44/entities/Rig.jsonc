{
  "name": "Rig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Rig name / identifier"
    },
    "type": {
      "type": "string",
      "description": "Type of rig (e.g. Drone, Camera, Gimbal)"
    },
    "serial_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "in_use",
        "maintenance",
        "retired"
      ],
      "default": "available"
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "last_service_date": {
      "type": "string",
      "format": "date"
    },
    "next_service_date": {
      "type": "string",
      "format": "date"
    },
    "image_url": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ]
}