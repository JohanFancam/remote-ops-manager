{
  "name": "ReferenceImage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title for this reference image"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what this image shows"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the uploaded reference image"
    },
    "type": {
      "type": "string",
      "enum": [
        "do",
        "dont",
        "info"
      ],
      "default": "info",
      "description": "Whether this shows a correct setup, incorrect setup, or general info"
    },
    "category": {
      "type": "string",
      "description": "Category e.g. Camera Setup, Rig Config, Sound, etc."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "image_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}