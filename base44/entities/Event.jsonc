{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "shoot",
        "training",
        "meeting",
        "maintenance",
        "other"
      ],
      "default": "other"
    },
    "linked_shoot_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "all_day": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "date"
  ]
}