{
  "name": "Shoot",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "game_time": {
      "type": "string"
    },
    "setup_offset": {
      "type": "number",
      "default": -150
    },
    "pre_shoot_offset": {
      "type": "number",
      "default": -120
    },
    "attention_offset": {
      "type": "number",
      "default": -30
    },
    "sound_offset": {
      "type": "number",
      "default": -30
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "upcoming"
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Short reason why this shoot was cancelled (required when status is cancelled)"
    },
    "earning_override": {
      "type": "number",
      "description": "Optional admin-set earning amount for a cancelled shoot (otherwise operator earns R0)"
    },
    "earning_override_reason": {
      "type": "string",
      "description": "Reason required when an admin awards an earning override on a cancelled shoot"
    },
    "rig_type_override": {
      "type": "string",
      "enum": [
        "Data",
        "Fancam",
        "Data/Fancam"
      ],
      "description": "Per-shoot rig type override (overrides rig setting default)"
    },
    "calendar_source": {
      "type": "string",
      "description": "Which calendar this shoot was imported from (CSV import)"
    },
    "description": {
      "type": "string"
    },
    "assigned_operators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_operators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pre_approved_operators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of operators whose assignment counts toward the 6-slot pre-approval limit"
    },
    "auto_assigned_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of operators auto-paired to this shoot"
    },
    "rig_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rate": {
      "type": "number"
    },
    "rate_type": {
      "type": "string",
      "enum": [
        "hourly",
        "day_rate",
        "fixed"
      ],
      "default": "day_rate"
    },
    "notes": {
      "type": "string"
    },
    "standby_admin": {
      "type": "string",
      "description": "Email of admin assigned as standby contact"
    },
    "phase_status": {
      "type": "object",
      "description": "Shoot phase completion timestamps",
      "properties": {
        "setup_complete": {
          "type": "string"
        },
        "pre_shoot_started": {
          "type": "string"
        },
        "attention_started": {
          "type": "string"
        },
        "sound_started": {
          "type": "string"
        },
        "game_started": {
          "type": "string"
        },
        "shoot_complete": {
          "type": "string"
        }
      }
    },
    "rig_check_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the standby/admin marked this shoot's rig as tested from the calendar"
    },
    "rig_check_checked_from_calendar": {
      "type": "boolean",
      "default": false
    },
    "rig_check_checked_by": {
      "type": "string",
      "description": "Email of the user who marked the rig checked"
    },
    "rig_check_checked_by_name": {
      "type": "string"
    },
    "rig_check_checked_at": {
      "type": "string",
      "description": "ISO timestamp when the rig was marked checked"
    },
    "rig_check_standby_date": {
      "type": "string",
      "format": "date"
    },
    "rig_check_standby_admin_email": {
      "type": "string"
    },
    "rig_check_standby_admin_name": {
      "type": "string"
    },
    "rig_check_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this rig-checked shoot was archived from the Slack message queue"
    },
    "rig_check_archived_at": {
      "type": "string"
    },
    "rig_check_archived_by": {
      "type": "string"
    },
    "rig_check_archived_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}