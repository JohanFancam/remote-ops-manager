{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key identifier"
    },
    "value": {
      "type": "string",
      "description": "Setting value (may be JSON string)"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ]
}