{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "standby"
      ],
      "default": "user"
    },
    "shoot_quota": {
      "type": "number",
      "default": 10,
      "description": "Required number of shoots (for standby role users)"
    }
  }
}